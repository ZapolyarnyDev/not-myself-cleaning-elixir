<section class="auth-panel">
  <div class="auth-copy">
    <p class="eyebrow">Новый клиент</p>
    <h1>Регистрация</h1>
    <p class="lead">Создайте аккаунт, чтобы быстро оставлять заявки и видеть все решения администратора.</p>
  </div>

  <form class="form" action="/register" method="post">
    <input type="hidden" name="_csrf_token" value={get_csrf_token()}>
    <%= if @error != "" do %>
      <p class="alert"><%= @error %></p>
    <% end %>
    <label>
      <span>Логин</span>
      <input name="login" value={Map.get(@values, "login", "")} autocomplete="username" required minlength="3" maxlength="30">
    </label>
    <label>
      <span>Пароль</span>
      <input name="password" type="password" autocomplete="new-password" required minlength="6">
    </label>
    <label>
      <span>ФИО</span>
      <input name="full_name" value={Map.get(@values, "full_name", "")} autocomplete="name" required>
    </label>
    <label>
      <span>Телефон</span>
      <input name="phone" value={Map.get(@values, "phone", "")} autocomplete="tel" placeholder="+7 999 123-45-67" required>
    </label>
    <label>
      <span>Электронная почта</span>
      <input name="email" type="email" value={Map.get(@values, "email", "")} autocomplete="email" required>
    </label>
    <button type="submit">Зарегистрироваться</button>
    <p class="muted">Уже есть аккаунт? <a href="/login">Войдите</a></p>
  </form>
</section>

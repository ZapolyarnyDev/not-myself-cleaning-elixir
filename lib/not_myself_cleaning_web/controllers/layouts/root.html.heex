<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content={get_csrf_token()}>
    <title><%= assigns[:page_title] || "Мой Не Сам" %></title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">Мой Не Сам</a>
      <%= if assigns[:current_user] do %>
        <nav class="nav">
          <a href="/requests">Заявки</a>
          <%= if !@current_user.is_admin do %>
            <a href="/requests/new">Новая заявка</a>
          <% end %>
          <%= if @current_user.is_admin do %>
            <a href="/admin">Админка</a>
          <% end %>
        </nav>
        <form action="/logout" method="post">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()}>
          <button class="ghost-button" type="submit">Выйти</button>
        </form>
      <% else %>
        <nav class="nav">
          <a href="/login">Вход</a>
          <a href="/register">Регистрация</a>
        </nav>
      <% end %>
    </header>

    <main class="page">
      <%= @inner_content %>
    </main>
    <script src="/request-date-picker.js" defer></script>
  </body>
</html>
